# Database Connection for Prisma & PostgreSQL (Supabase, Neon, Vercel Postgres, Railway)
# For serverless / pooled connections (e.g. Neon, Supabase Pooler, Vercel Postgres):
# Set DATABASE_URL to your transaction pooled connection string (port 6543 / pooled mode).
# Set DIRECT_URL to your direct session connection string (port 5432 / direct mode) for migrations.

DATABASE_URL="postgresql://postgres:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://postgres:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"
